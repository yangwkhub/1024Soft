---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { href, dict } from '../lib/data';
---
<BaseLayout title="页面不存在" description="你访问的页面不存在，试试搜索或从分类重新浏览。" path="404.html" noindex={true}>
  <div class="container" style="padding:80px 0 100px;text-align:center;max-width:640px">
    <div style="font-size:76px;font-weight:800;letter-spacing:-4px;line-height:1;background:linear-gradient(135deg,var(--primary),var(--primary-2));-webkit-background-clip:text;background-clip:text;color:transparent">404</div>
    <h1 style="font-size:26px;margin-top:14px">这个页面没有找到</h1>
    <p style="color:var(--muted);margin:12px 0 26px;line-height:1.8">链接可能已失效，或者这条软件刚被下架。可以搜索关键词，也可以从分类重新开始。</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
      <a class="btn" href={href()}><Icon name="home" size={16} /> 返回首页</a>
      <a class="btn btn-ghost" href={href('search/')}><Icon name="search" size={16} /> 搜索软件</a>
    </div>
    <div style="margin-top:38px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
      {dict.categories.slice(0, 6).map((c) => <a class="chip" href={href(`categories/${c.slug}/`)}>{c.name}</a>)}
    </div>
  </div>
</BaseLayout>
