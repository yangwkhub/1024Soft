---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import Icon from '../../components/Icon.astro';
import {
  getSoftware, markdownToHtml, PRICING, RISK, licenseName, platformName, categoryName,
  href, canonical
} from '../../lib/data';

export async function getStaticPaths() {
  const all = await getSoftware();
  return all.map((s) => ({ params: { slug: s.slug }, props: { item: s } }));
}
const { item: s } = Astro.props;
const all = await getSoftware();
const pricing = PRICING[s.pricing] || { label: s.pricing, tone: '' };
const initial = s.name.replace(/[^A-Za-z0-9\u4e00-\u9fff]/g, '').slice(0, 1).toUpperCase();
const logoClass = ['', 's1', 's2', 's3', 's4', 's5'][s.slug.length % 6];

const sameCategory = all.filter((x) => x.slug !== s.slug && x.categories.some((c) => s.categories.includes(c))).slice(0, 5);
const bodyHtml = markdownToHtml(s.body);

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication',
    name: s.name, description: s.description, applicationCategory: categoryName(s.categories[0] || ''),
    operatingSystem: s.platforms.map(platformName).join(', '),
    softwareVersion: s.version, author: { '@type': 'Organization', name: s.developer },
    ...(s.license_code ? { license: licenseName(s.license_code) } : {}),
    url: canonical(`software/${s.slug}/`),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' }
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: categoryName(s.categories[0] || ''), item: canonical(`categories/${s.categories[0] || ''}/`) },
      { '@type': 'ListItem', position: 2, name: s.name, item: canonical(`software/${s.slug}/`) }
    ]
  }
];
---
<BaseLayout title={s.seo_title || `${s.name} - ${s.tagline}`} description={s.seo_description || s.description} active="catalog" path={`software/${s.slug}/`} jsonLd={jsonLd}>
  <section class="detail-hero">
    <div class="container">
      <nav class="crumbs" aria-label="面包屑">
        <a href={href(`categories/${s.categories[0] || ''}/`)}>{categoryName(s.categories[0] || '')}</a><span>/</span>
        <span>{s.name}</span>
      </nav>
      <div class="detail-head">
        <div class={`soft-logo detail-logo ${logoClass}`} aria-hidden="true">{initial}</div>
        <div style="flex:1;min-width:260px">
          <h1 class="detail-title">{s.name}</h1>
          <p class="detail-tagline">{s.tagline}</p>
          <div class="detail-badges">
            <span class={`badge ${pricing.tone}`}>{pricing.label}</span>
            {s.license_code && <span class="badge">{licenseName(s.license_code)}</span>}
            {s.is_open_source && <span class="badge teal">✓ 开源</span>}
            <span class="badge"><Icon name="tag" size={12} /> v{s.version || '见官网'}</span>
            {s.freshness === 'stale' && <span class="badge amber">待复核</span>}
          </div>
        </div>
      </div>
      <div class="detail-actions">
        <a class="btn btn-lg" href={s.gotoUrl}><Icon name="download" size={18} /> 前往官网下载</a>
        <a class="btn btn-ghost btn-lg" href={s.homepage_url} target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer"><Icon name="external" size={16} /> 软件官网</a>
        {s.repo_url && <a class="btn btn-ghost btn-lg" href={s.repo_url} target="_blank" rel="noopener noreferrer nofollow"><Icon name="github" size={16} /> 源码仓库</a>}
      </div>
    </div>
  </section>

  <div class="container detail-layout">
    <div>
      {s.freshness === 'stale' && <p class="banner amber"><Icon name="clock" size={17} /> <span>信息超过 180 天未复核，版本与链接可能已过时，请以官网为准。</span></p>}
      {s.risk_level !== 'low' && <p class="banner red"><Icon name="shield" size={17} /> <span><strong>风险提示：</strong>{RISK[s.risk_level]}</span></p>}
      {s.pricing === 'freemium' && <p class="banner blue"><Icon name="alert" size={17} /> <span>该软件存在付费高级功能，本站仅收录其可免费使用的部分，详情请以官网说明为准。</span></p>}

      <article class="prose">
        <h2>软件简介</h2>
        <p>{s.description}</p>
        <Fragment set:html={bodyHtml} />
        <h2>结构化信息</h2>
        <table class="info-table"><tbody>
          <tr><th>开发者 / 组织</th><td>{s.developer || '未标注'}</td></tr>
          {s.license_code && <tr><th>许可证</th><td><a href={href(`licenses/${s.license_code}/`)}>{licenseName(s.license_code)}</a>（开源）</td></tr>}
          <tr><th>收费模式</th><td>{pricing.label}{s.pricing === 'freemium' ? ' · 含可选付费功能' : ''}</td></tr>
          <tr><th>支持平台</th><td>{s.platforms.map((p) => <a class="badge plain" style="margin-right:5px" href={href(`platforms/${p}/`)}>{platformName(p)}</a>)}</td></tr>
          <tr><th>最新稳定版</th><td>{s.version || '以官网为准'}{s.released_at ? ` · 发布于 ${s.released_at}` : ''}</td></tr>
          <tr><th>最后复核</th><td>{s.last_checked_at} · 每 180 天复核一次</td></tr>
          <tr><th>官方网站</th><td><a href={s.homepage_url} target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer">{s.homepage_url}</a></td></tr>
          {s.repo_url && <tr><th>源码仓库</th><td><a href={s.repo_url} target="_blank" rel="noopener noreferrer nofollow">{s.repo_url}</a></td></tr>}
          <tr><th>分类</th><td>{s.categories.map((c) => <a class="badge plain" style="margin-right:5px" href={href(`categories/${c}/`)}>{categoryName(c)}</a>)}</td></tr>
        </tbody></table>
      </article>

      <Comments slug={s.slug} name={s.name} />
    </div>

    <aside>
      <div class="side-card">
        <h3><Icon name="folder" size={15} /> 同分类软件</h3>
        {sameCategory.map((x) => <a class="side-link" href={x.pageUrl}><span class="mini-logo">{x.name.slice(0, 1)}</span><span>{x.name}<br /><small style="color:var(--muted)">{x.tagline}</small></span></a>)}
      </div>
    </aside>
  </div>
</BaseLayout>
