---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
import Icon from '../../components/Icon.astro';
import { href, BASE } from '../../lib/data';
const q = Astro.url.searchParams.get('q') || '';
---
<BaseLayout title={q ? `搜索「${q}」` : '搜索软件'} description="在 1024Soft 全文检索软件名称、简介与编辑点评，索引在构建期生成，无需服务端。" active="catalog" path="search/" noindex={true}>
  <div class="container" style="padding:44px 0 70px;max-width:900px">
    <div class="search-hero">
      <h1>搜索软件</h1>
      <SearchBox id="search-page-input" value={q} placeholder="输入软件名、功能，例如「录屏」「密码」「开源」…" />
      <p style="font-size:12.5px;color:var(--muted);margin-top:12px">检索范围：名称 · 一句话卖点 · 简介 · 编辑点评。索引由构建期生成，纯客户端查询，不上传任何关键词。</p>
    </div>
    <div class="toolbar" style="margin-top:26px"><span class="result-count" data-search-count>输入关键词开始搜索</span><span class="badge" data-search-driver>客户端索引</span></div>
    <div class="search-result-list" data-search-results></div>
    <div class="empty-state" data-search-empty hidden>
      <div class="emoji">🔎</div><h3>没有找到相关软件</h3>
      <p>换个关键词试试，或者<a href={href('submit/')} style="color:var(--primary)">推荐这款软件</a>给我们收录。</p>
    </div>
  </div>
</BaseLayout>
<script>
  // 不使用 define:vars（会变成内联脚本被 CSP 拦截）；由 Vite 在构建期注入 BASE_URL
  const rawBase = import.meta.env.BASE_URL || '/';
  const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
  const out = document.querySelector('[data-search-results]');
  const empty = document.querySelector('[data-search-empty]');
  const count = document.querySelector('[data-search-count]');
  const driver = document.querySelector('[data-search-driver]');
  const input = document.querySelector('#search-page-input');

  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
  const hi = (s, q) => {
    const safe = esc(s);
    if (!q) return safe;
    return safe.replace(new RegExp(esc(q).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), (m) => `<mark>${m}</mark>`);
  };
  const norm = (s) => String(s || '').toLowerCase().replace(/\s+/g, '');

  function scoreItem(item, q) {
    const n = norm(q);
    const name = norm(item.name), tagline = norm(item.tagline), desc = norm(item.description);
    const body = norm(item.body || ''), cats = norm((item.categories || []).join(' '));
    let score = 0;
    if (name.includes(n)) score += name === n ? 60 : 30;
    else if (n.split('').some((ch) => name.includes(ch))) score += 4;
    if (tagline.includes(n)) score += 20;
    if (cats.includes(n)) score += 12;
    if (desc.includes(n)) score += 10;
    if (body.includes(n)) score += 5;
    // 多字词按字拆分做宽松匹配，兼顾中文
    if (!score && n.length > 1) {
      const chars = [...n].filter((c) => c.trim());
      const hits = chars.filter((c) => (name + tagline + desc + body).includes(c)).length;
      if (hits / chars.length >= 0.7) score = 3;
    }
    return score;
  }

  const render = (items, q) => {
    if (!out) return;
    out.innerHTML = items.map((it) => `
      <a class="search-result" href="${esc(it.url)}">
        <div class="soft-logo" style="width:42px;height:42px;font-size:17px;border-radius:12px;flex:none">${esc(it.name.slice(0, 1))}</div>
        <div style="min-width:0;flex:1">
          <h3>${hi(it.name, q)} <span class="badge green" style="margin-left:6px">${esc(it.pricingLabel)}</span></h3>
          <p>${hi(it.tagline, q)} · ${hi(it.description.slice(0, 90), q)}…</p>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">
            ${(it.platforms || []).slice(0, 3).map((p) => `<span class="badge plain">${esc(p)}</span>`).join('')}
          </div>
        </div>
        <span style="color:var(--primary);align-self:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg></span>
      </a>`).join('');
  };

  async function run(rawQ) {
    const q = (rawQ || '').trim();
    if (!q) {
      if (out) out.innerHTML = '';
      if (empty) empty.hidden = false;
      if (count) count.textContent = '输入关键词开始搜索';
      return;
    }
    let items = [];
    let used = '客户端索引';
    // 优先尝试 Pagefind（PRD F3 主选），失败或无结果时回退到构建期 JSON 索引
    try {
      const pf = await import(/* @vite-ignore */ `${base}_pagefind/pagefind.js`);
      const res = await pf.search(q);
      if (res.results?.length) {
        const data = await Promise.all(res.results.slice(0, 60).map((r) => r.data()));
        // Pagefind 会索引全部页面；这里只保留软件详情页，避免分类 / 文档页混进结果
        items = data
          .filter((d) => /\/software\//.test(d.url || ''))
          .slice(0, 30)
          .map((d) => ({
            name: d.meta?.title || d.excerpt?.slice(0, 30) || '', tagline: d.excerpt || '',
            description: d.excerpt || '', platforms: [], url: d.url,
            pricingLabel: '免费', body: ''
          }));
        used = items.length ? 'Pagefind' : used;
      }
    } catch { /* 回退 */ }

    if (!items.length) {
      try {
        const idx = await fetch(`${base}data/search-index.json`).then((r) => r.json());
        items = idx.items
          .map((it) => ({ ...it, _score: scoreItem(it, q) }))
          .filter((it) => it._score > 0)
          .sort((a, b) => b._score - a._score || b.weight - a.weight)
          .slice(0, 30);
      } catch { items = []; }
    }
    render(items, q);
    if (empty) empty.hidden = items.length > 0;
    if (count) count.textContent = `找到 ${items.length} 条与「${q}」相关的结果`;
    if (driver) driver.textContent = used;
    const p = new URLSearchParams(location.search);
    q ? p.set('q', q) : p.delete('q');
    history.replaceState({}, '', `?${p.toString()}`);
  }

  document.querySelector('[data-search-form]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    run(input?.value || '');
  });
  input?.addEventListener('input', (e) => run(e.target.value));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && document.activeElement !== input && out?.firstElementChild) {
      (out.firstElementChild).click();
    }
  });
  // SSG 页面在构建期读不到 query，必须从浏览器 URL 恢复关键词（首页热门词 / 分享链接会带 ?q=）
  const initialQ = new URLSearchParams(location.search).get('q') || '';
  if (input && !input.value) input.value = initialQ;
  if (initialQ) document.title = `搜索「${initialQ}」 - 1024Soft`;
  run(initialQ);
</script>
